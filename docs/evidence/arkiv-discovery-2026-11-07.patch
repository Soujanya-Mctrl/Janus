@@ -0,0 +1,28 @@
+import { privateKeyToAccount } from 'viem/accounts';
+import { createPublicClient, http } from 'viem';
+import { rabdi } from '@arkiv-network/sdk/chains';
+import { createArkivDirectory, spec } from './directory.mjs';
+
+const command = process.argv[2] ?? 'query';
+const network = process.env.ARKIV_WORKER_NETWORK ?? 'eip155:296';
+try {
+ const directory = createArkivDirectory();
+ if (command === 'query') console.log(JSON.stringify(await directory.query({ network }), null, 2));
+ else if (command === 'preflight' || command === 'publish') {
+  const key = process.env.ARKIV_WRITER_PRIVATE_KEY;
+  if (!/^0x[0-9a-fA-F]{64}$/.test(key ?? '')) throw new Error('Configure a dedicated testnet ARKIV_WRITER_PRIVATE_KEY in backend/.env.arkiv');
+  const account = privateKeyToAccount(key);
+  const client = createPublicClient({ chain: rabdi({ accessKey: process.env.ARKIV_ACCESS_KEY ?? '' }), transport: http(undefined, { timeout: 12000, retryCount: 0 }) });
+  if (await client.getChainId() !== spec.chainId) throw new Error('Arkiv chain mismatch');
+  const balance = await client.getBalance({ address: account.address });
+  if (balance === 0n) throw new Error(`Fund dedicated Rabdi writer ${account.address} with test tGLM through https://hub.arkiv.network/faucet`);
+  if (command === 'preflight') console.log(JSON.stringify({ chainId: spec.chainId, writer: account.address, balanceWei: balance.toString(), network, writes: false }, null, 2));
+  else console.log(JSON.stringify({ writer: account.address, network,
+   ...await directory.publish({ account, name: process.env.ARKIV_WORKER_NAME ?? 'Janus research worker', network }) }, (_, value) => typeof value === 'bigint' ? value.toString() : value, 2));
+ } else throw new Error('Use query, preflight or publish');
+} catch (error) {
+ // SDK transport errors can contain private RPC access URLs; only print our own setup errors.
+ const message = error.message ?? '';
+ console.error(/^(Configure|Fund dedicated|Arkiv chain mismatch|Use query)/.test(message) ? message : 'Arkiv request failed. Check connectivity, access-key configuration and testnet status. No fallback was used.');
+ process.exitCode = 1;
+}
diff --git a/backend/arkiv/directory.mjs b/backend/arkiv/directory.mjs
new file mode 100644
index 0000000..697d731
--- /dev/null
+++ b/backend/arkiv/directory.mjs
@@ -0,0 +1,52 @@
+import { createPublicClient, createWalletClient, ExpirationTime } from '@arkiv-network/sdk';
+import { rabdi } from '@arkiv-network/sdk/chains';
+import { addr, defineSchema, str, u64 } from '@arkiv-network/sdk/schema';
+import { and, asc, eq, gt } from '@arkiv-network/sdk/query';
+import { http } from 'viem';
+import spec from '../../shared/arkiv-worker.json' with { type: 'json' };
+
+export { spec };
+export const WorkerProfiles = defineSchema(spec.schema, {
+ worker: addr().indexed(), role: str().indexed(), status: str().indexed(),
+ capabilities: str().indexed(), network: str().indexed(), scheme: str().indexed(),
+ validUntil: u64().indexed(), name: str(),
+});
+
+export function createArkivDirectory({ accessKey = process.env.ARKIV_ACCESS_KEY ?? '', transport } = {}) {
+ const chain = rabdi({ accessKey });
+ const rpc = transport ?? http(undefined, { timeout: 12000, retryCount: 0 });
+ const client = createPublicClient({ chain, transport: rpc });
+ return {
+  async query({ network, capability = spec.capability, scheme = spec.scheme, now = BigInt(Math.floor(Date.now() / 1000)) }) {
+   if (!/^eip155:[1-9][0-9]*$/.test(network) || capability !== spec.capability || scheme !== spec.scheme) throw new Error('Unsupported worker query');
+   if (await client.getChainId() !== spec.chainId) throw new Error('Arkiv chain mismatch');
+   const started = performance.now(), records = [], pages = [];
+   // Bounded, ordered pagination. Never silently select from a truncated directory.
+   for (let offset = 0; offset < 1000; offset += 100) {
+    const page = await client.select({ $key: true, $owner: true, $expiresAt: true, $updatedAt: true,
+     worker: true, role: true, status: true, capabilities: true, network: true, scheme: true, validUntil: true, name: true })
+     .from(WorkerProfiles).where(and(eq('role', spec.role), eq('status', 'ready'), eq('capabilities', capability),
+      eq('network', network), eq('scheme', scheme), gt('validUntil', u64(now))))
+     .orderBy(asc('$key')).limit(100).offset(offset).fetch();
+    pages.push({ block: String(page.blockNumber), skipped: page.skipped });
+    records.push(...page.entities.map(row => ({ entityKey: row.$key, owner: row.$owner, expiresAtBlock: String(row.$expiresAt),
+     updatedAtBlock: String(row.$updatedAt), address: row.worker.value, role: row.role.value, status: row.status.value,
+     capabilities: [row.capabilities.value], network: row.network.value, scheme: row.scheme.value,
+     validUntil: String(row.validUntil.value), name: row.name.value })));
+    if (page.entities.length + page.skipped < 100) {
+     return { source: 'arkiv-rabdi', chainId: spec.chainId, block: String(await client.getBlockNumber({ cacheTime: 0 })),
+      queriedAt: now.toString(), latencyMs: Math.round(performance.now() - started), pages, records };
+    }
+   }
+   throw new Error('Arkiv directory exceeds 1000 records; narrow the query');
+  },
+  async publish({ account, name, network }) {
+   if (!name?.trim() || name.length > 50 || !/^eip155:[1-9][0-9]*$/.test(network)) throw new Error('Invalid public worker profile');
+   if (await client.getChainId() !== spec.chainId) throw new Error('Arkiv chain mismatch');
+   const wallet = createWalletClient({ chain, transport: rpc, account });
+   return wallet.createEntity(WorkerProfiles, { worker: addr(account.address), role: spec.role, status: 'ready',
+    capabilities: spec.capability, network, scheme: spec.scheme, validUntil: u64(BigInt(Math.floor(Date.now() / 1000) + spec.leaseSeconds)), name: name.trim() },
+    { expiration: ExpirationTime.fromHours(1) });
+  },
+ };
+}
diff --git a/backend/arkiv/discovery.mjs b/backend/arkiv/discovery.mjs
new file mode 100644
index 0000000..c7d7222
--- /dev/null
+++ b/backend/arkiv/discovery.mjs
@@ -0,0 +1,92 @@
+import { randomBytes } from 'node:crypto';
+import { verifyMessage } from 'viem';
+import { selectReplacement } from '../runner/checkpoint-runner.mjs';
+import spec from '../../shared/arkiv-worker.json' with { type: 'json' };
+
+const same = (a, b) => typeof a === 'string' && typeof b === 'string' && a.toLowerCase() === b.toLowerCase();
+const address = value => /^0x[0-9a-fA-F]{40}$/.test(value ?? '') && !/^0x0{40}$/.test(value);
+const integer = value => typeof value === 'string' && /^[0-9]+$/.test(value);
+async function readiness(probe, input) {
+ const controller = new AbortController();
+ let timer;
+ try {
+  return await Promise.race([probe({ ...input, signal: controller.signal }), new Promise((_, reject) => {
+   timer = setTimeout(() => { controller.abort(); reject(new Error('Readiness timeout')); }, 5000);
+  })]);
+ } finally { clearTimeout(timer); }
+}
+
+export async function discoverReplacement({ directory, network, taskId, treasury, epoch, failedWorker,
+ authorize, probe, now = () => BigInt(Math.floor(Date.now() / 1000)) }) {
+ if (typeof authorize !== 'function' || typeof probe !== 'function') throw new Error('Discovery requires owner policy and authenticated worker readiness');
+ const queriedAt = now();
+ // RPC errors propagate: no local-directory or cached fallback.
+ const snapshot = await directory.query({ network, capability: spec.capability, scheme: spec.scheme, now: queriedAt });
+ if (snapshot.chainId !== spec.chainId || !integer(snapshot.block) || !Array.isArray(snapshot.records)) throw new Error('Invalid Arkiv snapshot');
+ const rejected = [], latest = new Map();
+ for (const record of snapshot.records) {
+  let reason;
+  if (!address(record.address) || !same(record.owner, record.address)) reason = 'owner-worker mismatch';
+  else if (!/^0x[0-9a-fA-F]{64}$/.test(record.entityKey ?? '') || !integer(record.updatedAtBlock)
+    || BigInt(record.updatedAtBlock) > BigInt(snapshot.block)) reason = 'invalid entity';
+  else if (!integer(record.expiresAtBlock) || BigInt(record.expiresAtBlock) <= BigInt(snapshot.block)
+    || !integer(record.validUntil) || BigInt(record.validUntil) <= now()) reason = 'expired';
+  else if (record.network !== network || record.scheme !== spec.scheme || record.role !== spec.role
+    || record.status !== 'ready' || !Array.isArray(record.capabilities) || !record.capabilities.includes(spec.capability)) reason = 'incompatible';
+  else if (same(record.address, failedWorker)) reason = 'failed worker';
+  if (reason) { rejected.push({ entityKey: record.entityKey ?? null, reason }); continue; }
+  const key = record.address.toLowerCase(), prior = latest.get(key);
+  // Repeated wallet publications cannot create duplicate worker identities.
+  if (!prior || BigInt(record.updatedAtBlock) > BigInt(prior.updatedAtBlock)
+    || (record.updatedAtBlock === prior.updatedAtBlock && record.entityKey < prior.entityKey)) latest.set(key, record);
+ }
+ const candidates = [];
+ for (const record of [...latest.values()].sort((a, b) => a.address.toLowerCase().localeCompare(b.address.toLowerCase()))) {
+  if (await authorize(record.address, record) !== true) { rejected.push({ entityKey: record.entityKey, reason: 'not owner-authorized' }); continue; }
+  const deadline = now() + 30n;
+  const message = JSON.stringify({ domain: 'janus.worker.readiness.v1', network, treasury: treasury.toLowerCase(), taskId,
+   epoch: String(epoch), entityKey: record.entityKey, worker: record.address.toLowerCase(), ready: true,
+   nonce: randomBytes(32).toString('hex'), deadline: deadline.toString() });
+  let ready = false;
+  try {
+   const response = await readiness(probe, { worker: record, message });
+   ready = response?.busy === false && now() < deadline && BigInt(record.validUntil) > now()
+    && await verifyMessage({ address: record.address, message, signature: response.signature });
+  } catch { /* An unreachable or unauthenticated worker is ineligible. */ }
+  if (!ready) { rejected.push({ entityKey: record.entityKey, reason: 'readiness rejected' }); continue; }
+  candidates.push({ ...record, authorized: true, busy: false, expiresAt: record.validUntil, readinessDeadline: deadline.toString() });
+ }
+ const selected = selectReplacement(candidates.filter(record => BigInt(record.readinessDeadline) > now()), { requiredCapabilities: [spec.capability], failedWorker, now: now() });
+ return { status: selected ? 'selected' : 'waiting', selected, evidence: {
+  source: snapshot.source ?? 'arkiv', chainId: String(snapshot.chainId), block: snapshot.block, queriedAt: snapshot.queriedAt ?? queriedAt.toString(),
+  latencyMs: snapshot.latencyMs === undefined ? null : String(snapshot.latencyMs), recordsRead: String(snapshot.records.length), rejected,
+  selected: selected ? { address: selected.address, entityKey: selected.entityKey, owner: selected.owner,
+   validUntil: selected.validUntil, expiresAtBlock: selected.expiresAtBlock } : null,
+ } };
+}
+
+export async function handoffFromArkiv({ runner, directory, publicClient, manifest, taskId, schedulerWallet, authorize, probe, afterAssignment, failedWorker }) {
+ const state = await runner.inspect();
+ if (state.handoff?.discovery && (state.handoff.status === 'intent' || (state.handoff.status === 'confirmed' && !failedWorker))) {
+  // Reconcile an already-broadcast assignment even after its directory lease expires.
+  return { status: 'reconciled', state: await runner.handoff({ schedulerWallet, replacement: state.handoff.replacement,
+   eligible: async () => { throw new Error('Pending handoff must only reconcile'); }, afterAssignment }) };
+ }
+ const { taskTreasuryAbi } = await import('../hedera/lib/treasury.mjs');
+ const task = await publicClient.readContract({ address: manifest.treasury, abi: taskTreasuryAbi, functionName: 'tasks', args: [taskId] });
+ if (failedWorker && !same(task[6], failedWorker)) throw new Error('Failed worker no longer assigned');
+ const decision = await discoverReplacement({ directory, network: `eip155:${manifest.chainId}`, taskId, treasury: manifest.treasury,
+  epoch: task[8], failedWorker: task[6], authorize, probe });
+ if (!decision.selected) return decision;
+ const replacement = decision.selected;
+ const result = await runner.handoff({ schedulerWallet, replacement: replacement.address, discovery: decision.evidence,
+  eligible: async () => {
+   const current = await publicClient.readContract({ address: manifest.treasury, abi: taskTreasuryAbi, functionName: 'tasks', args: [taskId] });
+   if (!same(current[6], task[6]) || current[8] !== task[8]) return false;
+   const checked = await discoverReplacement({ directory, network: `eip155:${manifest.chainId}`, taskId, treasury: manifest.treasury,
+    epoch: current[8], failedWorker: current[6], authorize: async (address, record) => same(address, replacement.address)
+     && record.entityKey === replacement.entityKey && await authorize(address, record) === true, probe });
+   return checked.selected?.entityKey === replacement.entityKey;
+  }, afterAssignment });
+ return { ...decision, state: result };
+}
diff --git a/backend/arkiv/discovery.test.mjs b/backend/arkiv/discovery.test.mjs
new file mode 100644
index 0000000..382c627
--- /dev/null
+++ b/backend/arkiv/discovery.test.mjs
@@ -0,0 +1,109 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { custom } from 'viem';
+import { privateKeyToAccount } from 'viem/accounts';
+import { createArkivDirectory } from './directory.mjs';
+import { discoverReplacement } from './discovery.mjs';
+
+const worker = privateKeyToAccount(`0x${'12'.repeat(32)}`), impostor = privateKeyToAccount(`0x${'13'.repeat(32)}`);
+const entityKey = `0x${'ab'.repeat(32)}`;
+const profile = { entityKey, address: worker.address, owner: worker.address, updatedAtBlock: '90', expiresAtBlock: '110',
+ validUntil: '2000', network: 'eip155:296', scheme: 'janus-task-v1', role: 'researcher', status: 'ready', capabilities: ['research'] };
+const options = records => ({ directory: { query: async () => ({ chainId: 7794095, source: 'fixture-not-testnet', block: '100', queriedAt: '1000', records }) },
+ network: 'eip155:296', taskId: `0x${'cd'.repeat(32)}`, treasury: `0x${'11'.repeat(20)}`, epoch: 1n,
+ authorize: async () => true, probe: async ({ message }) => ({ busy: false, signature: await worker.signMessage({ message }) }), now: () => 1000n });
+
+test('signed readiness is bound to the task, treasury, epoch, entity and fresh nonce', async () => {
+ const messages = [];
+ const run = () => discoverReplacement({ ...options([profile]), probe: async ({ message }) => {
+  messages.push(message); return { busy: false, signature: await worker.signMessage({ message }) };
+ } });
+ assert.equal((await run()).selected.address, worker.address);
+ await run();
+ assert.notEqual(JSON.parse(messages[0]).nonce, JSON.parse(messages[1]).nonce);
+ const data = JSON.parse(messages[0]);
+ assert.equal(data.entityKey, entityKey); assert.equal(data.epoch, '1'); assert.equal(data.ready, true);
+ assert.equal(data.taskId, options([]).taskId); assert.equal(data.treasury, options([]).treasury);
+});
+
+test('ownership, lease seconds, expiry blocks, compatibility and policy reject unsafe workers', async () => {
+ const cases = [
+  { owner: impostor.address }, { validUntil: '1000' }, { expiresAtBlock: '100' },
+  { capabilities: ['other'] }, { network: 'eip155:1' }, { scheme: 'other' }, { status: 'busy' },
+  { updatedAtBlock: '101' }, { validUntil: 'NaN' }, { entityKey: 'bad' },
+ ];
+ for (const change of cases) assert.equal((await discoverReplacement(options([{ ...profile, ...change }]))).status, 'waiting', JSON.stringify(change));
+ assert.equal((await discoverReplacement({ ...options([profile]), failedWorker: worker.address })).status, 'waiting');
+ assert.equal((await discoverReplacement({ ...options([profile]), authorize: async () => false })).status, 'waiting');
+});
+
+test('copied signatures, busy and unreachable workers cannot be selected; RPC failure has no fallback', async () => {
+ const signature = await worker.signMessage({ message: 'unrelated readiness' });
+ for (const probe of [async () => ({ signature, busy: false }), async ({ message }) => ({ signature: await impostor.signMessage({ message }), busy: false }),
+  async ({ message }) => ({ signature: await worker.signMessage({ message }), busy: true }), async () => { throw new Error('offline'); }]) {
+  assert.equal((await discoverReplacement({ ...options([profile]), probe })).status, 'waiting');
+ }
+ assert.equal((await discoverReplacement(options([]))).status, 'waiting');
+ await assert.rejects(() => discoverReplacement({ ...options([profile]), directory: { query: async () => { throw new Error('RPC offline'); } } }), /RPC offline/);
+});
+
+test('duplicate publications resolve deterministically to the newest valid wallet record', async () => {
+ const newer = { ...profile, entityKey: `0x${'ef'.repeat(32)}`, updatedAtBlock: '95' };
+ for (const records of [[profile, newer], [newer, profile]]) assert.equal((await discoverReplacement(options(records))).selected.entityKey, newer.entityKey);
+});
+
+test('expired readiness response and lease expiry during the probe are rejected', async () => {
+ let time = 1000n;
+ assert.equal((await discoverReplacement({ ...options([profile]), now: () => time, probe: async ({ message }) => {
+  time += 31n; return { busy: false, signature: await worker.signMessage({ message }) };
+ } })).status, 'waiting');
+ time = 1000n;
+ assert.equal((await discoverReplacement({ ...options([{ ...profile, validUntil: '1010' }]), now: () => time, probe: async ({ message }) => {
+  time += 11n; return { busy: false, signature: await worker.signMessage({ message }) };
+ } })).status, 'waiting');
+});
+
+test('real SDK sends typed v2 filters and decodes expiry as blocks', async () => {
+ const calls = [];
+ const attributes = Object.entries({ 'arkiv.schema': 'janus.worker.v2', worker: worker.address, role: 'researcher', status: 'ready',
+  capabilities: 'research', network: 'eip155:296', scheme: 'janus-task-v1', validUntil: '0x7d0', name: 'Research worker' })
+  .map(([name, value]) => ({ name, value, type: name === 'worker' ? 'addr' : name === 'validUntil' ? 'u64' : 'str' }));
+ const directory = createArkivDirectory({ accessKey: '', transport: custom({ request: async request => {
+  calls.push(request);
+  if (request.method === 'eth_chainId') return '0x76edaf';
+  if (request.method === 'eth_blockNumber') return '0x64';
+  if (request.method === 'arkiv_query') return { blockNumber: '0x64', data: [{ key: entityKey, owner: worker.address, updatedAt: '0x5a', expiresAt: '0x6e', attributes }] };
+  throw new Error('Unexpected RPC method');
+ } }, { retryCount: 0 }) });
+ const snapshot = await directory.query({ network: 'eip155:296', now: 1000n });
+ assert.equal(snapshot.records[0].expiresAtBlock, '110');
+ assert.equal(snapshot.records[0].validUntil, '2000');
+ const query = calls.find(call => call.method === 'arkiv_query').params[0];
+ assert.match(query, /janus.worker.v2/); assert.match(query, /validUntil > u64\(1000\)/); assert.match(query, /network = str\('eip155:296'\)/);
+});
+
+test('SDK pagination counts schema-skipped rows and refuses a truncated directory', async () => {
+ const offsets = [];
+ let saturated = false;
+ const directory = createArkivDirectory({ accessKey: '', transport: custom({ request: async request => {
+  if (request.method === 'eth_chainId') return '0x76edaf';
+  if (request.method === 'eth_blockNumber') return '0x64';
+  if (request.method === 'arkiv_query') {
+   const offset = Number(BigInt(request.params[1].offset)); offsets.push(offset);
+   return { blockNumber: '0x64', data: saturated || offset === 0 ? Array.from({ length: 100 }, () => ({ key: entityKey, attributes: [] })) : [] };
+  }
+  throw new Error('Unexpected RPC method');
+ } }, { retryCount: 0 }) });
+ assert.deepEqual((await directory.query({ network: 'eip155:296', now: 1000n })).records, []);
+ assert.deepEqual(offsets, [0, 100]);
+ saturated = true; offsets.length = 0;
+ await assert.rejects(() => directory.query({ network: 'eip155:296', now: 1000n }), /exceeds 1000/);
+ assert.equal(offsets.length, 10);
+});
+
+test('wrong-chain RPC is rejected before querying a directory', async () => {
+ const methods = [];
+ const directory = createArkivDirectory({ accessKey: '', transport: custom({ request: async ({ method }) => { methods.push(method); return '0x1'; } }, { retryCount: 0 }) });
+ await assert.rejects(() => directory.query({ network: 'eip155:296' }), /chain mismatch/);
+ assert.deepEqual(methods, ['eth_chainId']);
+});
diff --git a/backend/arkiv/live-demo.mjs b/backend/arkiv/live-demo.mjs
new file mode 100644
index 0000000..805b639
--- /dev/null
+++ b/backend/arkiv/live-demo.mjs
@@ -0,0 +1,42 @@
+import fs from 'node:fs/promises';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+import { privateKeyToAccount } from 'viem/accounts';
+import { createPublicClient, http } from 'viem';
+import { rabdi } from '@arkiv-network/sdk/chains';
+import { createArkivDirectory } from './directory.mjs';
+
+// Explicit opt-in command: only discovery publication is live; all payments are local.
+const evidence = fileURLToPath(new URL('../.runner-state/arkiv-live/', import.meta.url));
+await fs.mkdir(evidence, { recursive: true, mode: 0o700 });
+try {
+ const key = process.env.ARKIV_WRITER_PRIVATE_KEY;
+ if (!/^0x[0-9a-fA-F]{64}$/.test(key ?? '')) throw new Error('Configure ARKIV_WRITER_PRIVATE_KEY in backend/.env.arkiv first');
+ const account = privateKeyToAccount(key);
+ const client = createPublicClient({ chain: rabdi({ accessKey: process.env.ARKIV_ACCESS_KEY ?? '' }), transport: http(undefined, { timeout: 12000, retryCount: 0 }) });
+ if (await client.getBalance({ address: account.address }) === 0n) throw new Error(`Fund dedicated Rabdi writer ${account.address} with test tGLM first`);
+ const registry = createArkivDirectory();
+ // Query before spending gas, then publish a profile explicitly advertising the LOCAL demo network.
+ await registry.query({ network: 'eip155:1337' });
+ const publication = await registry.publish({ account, name: 'Janus local-handoff test worker', network: 'eip155:1337' });
+ await fs.writeFile(`${evidence}/publication.json`, JSON.stringify({ generatedAt: new Date().toISOString(), writer: account.address,
+  network: 'Rabdi discovery only; local EVM treasury/payments', ...publication }, (_, value) => typeof value === 'bigint' ? value.toString() : value, 2) + '\n');
+ let found = false;
+ for (let attempt = 0; attempt < 6; attempt++) {
+  const snapshot = await registry.query({ network: 'eip155:1337' });
+  if (snapshot.records.some(record => record.entityKey === publication.entityKey)) {
+   await fs.writeFile(`${evidence}/query.json`, JSON.stringify(snapshot, null, 2) + '\n'); found = true; break;
+  }
+  await new Promise(resolve => setTimeout(resolve, 1500));
+ }
+ if (!found) throw new Error('Publication not discoverable yet; retain publication.json and retry the independent query before another publication');
+ const result = spawnSync(process.execPath, ['--test', fileURLToPath(new URL('../hedera/test/checkpoint-runner.test.mjs', import.meta.url))], {
+  stdio: 'inherit', env: { ...process.env, JANUS_ARKIV_LIVE_DEMO: '1', JANUS_ARKIV_ENTITY_KEY: publication.entityKey, JANUS_DEMO_EVIDENCE_DIR: evidence },
+ });
+ process.exitCode = result.status ?? 1;
+ console.log(`Evidence: ${evidence}. Discovery used Rabdi; treasury and paid results used a local EVM. No live Hedera payment occurred.`);
+} catch (error) {
+ const message = error.message ?? '';
+ console.error(/^(Configure|Fund dedicated|Publication not)/.test(message) ? message : 'Live Arkiv demo failed. Retain any publication evidence and check RPC connectivity/configuration before retrying.');
+ process.exitCode = 1;
+}
