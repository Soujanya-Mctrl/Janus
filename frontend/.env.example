# Copy to frontend/.env.local. Empty configuration keeps sign-in disabled.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional client ID from the same Privy application.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# WalletConnect Project ID for mobile wallet QR codes (from cloud.reown.com or Privy dashboard)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Server-only ES256 public verification key. Literal \n separators are supported.
PRIVY_VERIFICATION_KEY=
# Optional custom deployment; all four values are required for local mode.
# Absolute path to the same public manifest used by merchant and supervisor.
JANUS_DEPLOYMENT_FILE=
# Internal service RPC, never exposed by /api/deployment.
JANUS_RPC_URL=
# Public, credential-free RPC reachable from the user's browser.
JANUS_BROWSER_RPC_URL=
# Internal merchant base URL; its /deployment must match the manifest.
JANUS_MERCHANT_URL=
# Server-only vault master key: base64-encoded 32 bytes. Required in production
# unless JANUS_VAULT_KEY_FILE is configured. Local development alone generates
# an ignored .workbench-state/vault/master.key if both are empty.
JANUS_VAULT_KEY=
# Absolute path outside the vault directory, containing a base64 vault key.
JANUS_VAULT_KEY_FILE=
# Absolute path outside protected state, containing a versioned data keyring.
# Required in production for research/paid checkpoint/merchant persistence.
# See shared/SECURITY_EXPERIMENT.md. Never use NEXT_PUBLIC_ for these values.
JANUS_DATA_KEYRING_FILE=
# Optional absolute monorepo root and persistent private state directory.
JANUS_WORKSPACE_ROOT=
JANUS_WORKBENCH_STATE_DIR=
# Public, origin-restricted Arkiv RPC access key. Never put an LLM key here.
NEXT_PUBLIC_ARKIV_ACCESS_KEY=
